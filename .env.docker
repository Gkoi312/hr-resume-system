# ── Database ──
DATABASE_URL=postgresql+asyncpg://hr_resume:hr_resume@db:5432/hr_resume
VECTOR_STORE_BACKEND=pgvector

# ── JWT ──
JWT_SECRET=docker-demo-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Embedding: debug (no external deps needed for demo) ──
EMBEDDING_PROVIDER=debug
EMBEDDING_DIM=384

# ── JD/Resume parsing: text-only (no LLM API key needed) ──
JOB_LLM_ENABLED=0
RESUME_LLM_ENABLED=0
RESUME_LLM_VISION=0
RESUME_VLLM_ENABLED=0
RESUME_PADDLE_ENABLED=0

# ── Worker ──
TASK_WORKER_POLL_INTERVAL=5
TASK_WORKER_MAX_CONCURRENCY=2

# ── Demo UI ──
HR_API_BASE_URL=http://api:8000/api/v1
